{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": ["${CLAUDE_PLUGIN_ROOT}/run.py", "hook", "session-start"],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": ["${CLAUDE_PLUGIN_ROOT}/run.py", "hook", "recall"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
